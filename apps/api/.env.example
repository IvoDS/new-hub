# Server configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (MariaDB)
DB_DIALECT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hub_db
DB_USER=hub_user
DB_PASSWORD=hub_password

# Set to true to use SQLite if MariaDB is not running locally
DB_FALLBACK_SQLITE=true
DB_SQLITE_STORAGE=./dev_local.sqlite

# Security & Admin Dev Bypass
JWT_SECRET=super-secret-local-jwt-token-replace-in-production
ALLOW_DEV_ADMIN_BYPASS=true
DEV_ADMIN_TOKEN=dev-secret-token

# Caddy Reverse Proxy Admin API
CADDY_ADMIN_URL=http://127.0.0.1:2019
CADDY_BLUE_UPSTREAM=127.0.0.1:3001
CADDY_GREEN_UPSTREAM=127.0.0.1:3002

# Storage
UPLOAD_DIR=./uploads
