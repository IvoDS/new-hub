# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (ivandestefani.it)
# Save this file as .env on your server in the repository root or docker/ folder
# ==============================================================================

DOMAIN=ivandestefani.it

# MariaDB Production Credentials
DB_NAME=hub_db
DB_USER=hub_user
DB_PASSWORD=GenerateAStrongRandomPasswordHere123!
DB_ROOT_PASSWORD=GenerateAStrongRootPasswordHere456!

# JWT & Authentication Secret
JWT_SECRET=GenerateAHighEntropyJwtSecretKeyWithAtLeast32Chars!

# Whitelisted Administrator Emails (comma-separated)
ADMIN_EMAILS=your.email@gmail.com,contact@ivandestefani.it

# Admin dev bypass must be disabled in production
ALLOW_DEV_ADMIN_BYPASS=false

# Caddy Reverse Proxy Admin API
# Points to your existing Caddy host admin port
CADDY_ADMIN_URL=http://host.docker.internal:2019
CADDY_BLUE_UPSTREAM=127.0.0.1:3001
CADDY_GREEN_UPSTREAM=127.0.0.1:3002
