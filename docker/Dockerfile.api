# --- Stage 1: Build Stage ---
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm & dependencies needed for native modules
RUN apk add --no-cache python3 make g++ gcc
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

# Copy root workspace files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./

# Copy packages
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build shared library and API
RUN pnpm --filter @hub/shared build
RUN pnpm --filter @hub/api build

# --- Stage 2: Production Runner ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache docker-cli docker-cli-compose git curl bash
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 apiuser

# Copy root configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy built artifacts and package manifests
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Create uploads directory and set permissions
RUN mkdir -p /app/apps/api/uploads && chown -R apiuser:nodejs /app

USER apiuser

WORKDIR /app/apps/api

EXPOSE 4000

CMD ["node", "dist/server.js"]
